{
  "description": "Navigate the internet only using your brain",
  "manifest_version": 3,
  "name": "BCI-Unicorn-Hybrid-Black_Firefox-plugin",
  "version": "1.0.0",
  "homepage_url": "https://github.com/bneiG1/BCI-Unicorn-Hybrid-Black_Firefox-plugin",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/flasher/overlay_injector.js"],
      "css": ["src/flasher/speller_matrix.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/flasher/speller_matrix.html",
        "src/flasher/speller_matrix.js",
        "src/flasher/speller_matrix.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}